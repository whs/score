<!doctype html>
<html>
<head>
	<meta charset="UTF-8">
	<title>ระบบประกาศผลคะแนนสอบ</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="color-scheme" content="light dark">
	{{ vite_entry_link_tags('adminCSS') }}
	{% block head %}{% endblock %}
</head>
<body>
<header>
	<div class="grid">
		<h1>ระบบประกาศผลคะแนนสอบ</h1>
		{% if app.user %}
		<div>
			{{app.user}} &middot;
			<a href="{{url('_logout_main')}}">ออกจากระบบ</a>
		</div>
		{% endif %}
	</div>
</header>
<main class="container">
{% block body %}{% endblock %}
</main>
</body>
</html>